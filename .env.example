# =============================================================================
# GLM-5.3 SMB Financial Intelligence Suite - environment variables
#
# Copy to `.env` (or export in your shell / launchd plist / crontab) and fill
# in real values. `.env` is gitignored; never commit real credentials.
#
# Every tool also accepts its connection on the command line; env vars are
# the cron/launchd-friendly path. All values below are EXAMPLES.
# =============================================================================

# --- Warehouse connection (used by nearly everything) -----------------------
# Default PostgreSQL DSN for the whole suite. Scripts fall back to this when
# nothing more specific is set. Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/smb_warehouse

# --- Doc-to-Warehouse (:8603) -----------------------------------------------
# The push-to-warehouse panel's target (falls back to DATABASE_URL).
WAREHOUSE_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/smb_warehouse

# Optional LLM fallback for pages where rule-based parsing yields nothing or
# only low-confidence rows. Leave unset to stay 100% offline (recommended;
# the sample PDFs never need it).
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=

# --- Data Warehouse (:8602) - Ask-Your-Data (NL-to-SQL) ----------------------
# Restricted DB role + password used by the natural-language query tab.
# The role and its RLS policies are created by migrations/002_add_rls.sql.
NL2SQL_DB_ROLE=nl2sql_reader
NL2SQL_DB_PASSWORD=CHANGE_ME_ROTATE_ME

# Optional LLM endpoint for natural-language queries (the tab works without
# a key only in mocked/test mode).
NL2SQL_BASE_URL=
NL2SQL_API_KEY=
NL2SQL_MODEL=
NL2SQL_LLM_TIMEOUT=60        # seconds for the LLM HTTP call
NL2SQL_QUERY_TIMEOUT=5       # seconds; sets statement_timeout per query

# --- SMB-Watchdog (CLI / cron) -----------------------------------------------
# Read-only connection for watchdog.py (falls back to DATABASE_URL).
SMB_WATCHDOG_DSN=postgresql://postgres:CHANGE_ME@localhost:5432/smb_warehouse

# --- backup_db.sh / restore_db.sh --------------------------------------------
# Standard libpq variables are honored (used when DATABASE_URL is unset).
# PGBIN optionally points at the PostgreSQL bin directory (pg_dump etc.).
PGHOST=localhost
PGPORT=5432
PGDATABASE=smb_warehouse
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGBIN=

# --- PostgreSQL server management (start_db.sh / stop_db.sh) -----------------
# Only needed on the machine hosting the Postgres binaries/data dir.
# PGDATA=/path/to/pgdata/smb_warehouse
